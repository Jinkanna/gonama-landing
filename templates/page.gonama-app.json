        "content_html": "<div class=\"gonama-form-section-4\">\n  \n\n  <form method=\"post\" action=\"/contact#contact_form\" accept-charset=\"UTF-8\" class=\"gonama-contact-form-4\" id=\"gonama_form_4\">\n    <input type=\"hidden\" name=\"form_type\" value=\"contact\">\n    <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n    <input type=\"hidden\" name=\"contact[email]\" value=\"sin@email.com\">\n    <input type=\"hidden\" name=\"contact[body]\" id=\"contact_body_4\" value=\"\">\n\n    <input type=\"text\" name=\"fields[nombre_completo]\" placeholder=\"Nombre Completo\" required=\"\" class=\"gonama-input-4\">\n\n    <input type=\"text\" name=\"fields[sitio_web]\" placeholder=\"Sitio web de tu tienda (opcional)\" class=\"gonama-input-4\">\n\n    <input type=\"tel\" name=\"fields[celular]\" placeholder=\"Celular (ej: 099123456)\" required=\"\" class=\"gonama-input-4\">\n\n    <button type=\"submit\" class=\"gonama-button-4\">Enviar</button>\n\n    \n  </form>\n</div>\n\n<script>\n  document.getElementById('gonama_form_4').addEventListener('submit', function (e) {\n    const nombre = document.querySelector('[name=\"fields[nombre_completo]\"]').value;\n    const sitio = document.querySelector('[name=\"fields[sitio_web]\"]').value;\n    const celular = document.querySelector('[name=\"fields[celular]\"]').value;\n\n    const mensaje =\n      `Nombre completo: ${nombre}\\n` +\n      `Sitio web: ${sitio || 'No informado'}\\n` +\n      `Celular: ${celular}`;\n\n    document.getElementById('contact_body_4').value = mensaje;\n  });\n</script>",
