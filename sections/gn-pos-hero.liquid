{% comment %}
  GOnama · new-pos · Hero
  Titular apilado en mayúsculas: cada línea entra desde abajo, escalonada.
  Las líneas se cargan una por renglón en el editor.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
>
{%- render 'gn-pos-assets' -%}

{%- liquid
  assign st = section.settings
  assign lines = st.headline | newline_to_br | split: '<br />'
-%}

<section class="gnp gnp--{{ st.tone }} gnp-hero" id="section-{{ section.id }}">
  <div class="gnp__in">
    {%- if st.label != blank -%}
      <p class="gnp__label gnp-hero__label gnp-rv">{{ st.label | escape }}</p>
    {%- endif -%}

    <h1 class="gnp__display" data-gnp-lines>
      {%- for line in lines -%}
        {%- assign clean = line | strip_html | strip -%}
        {%- if clean != blank -%}
          <span class="gnp-line"><span>{{ clean | escape }}</span></span>
        {%- endif -%}
      {%- endfor -%}
    </h1>

    <div class="gnp-hero__foot">
      {%- if st.sub != blank -%}
        <p class="gnp__sub gnp-rv">{{ st.sub | escape }}</p>
      {%- endif -%}

      {%- if st.cta1_label != blank or st.cta2_label != blank -%}
        <div class="gnp-hero__actions gnp-rv">
          {%- if st.cta1_label != blank -%}
            <a class="gnp__btn" href="{{ st.cta1_link | default: '#gnp-contact' }}">
              {{ st.cta1_label | escape }}
              <svg class="gnp__arrow" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if st.cta2_label != blank -%}
            <a class="gnp__btn gnp__btn--ghost" href="{{ st.cta2_link | default: '#' }}">
              {{ st.cta2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "POS · Hero",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tono",
      "options": [
        { "value": "a", "label": "Base" },
        { "value": "b", "label": "Invertido" }
      ],
      "default": "a"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "Agentic commerce infrastructure"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Titular",
      "info": "Una línea por renglón. Cada renglón entra por separado.",
      "default": "One platform\nevery step\nof the sale"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Bajada",
      "default": "Checkout, payments, fulfilment and AI agents, unified across Latin America under one accountable platform."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Botón 1",
      "default": "Talk with us"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Link del botón 1"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Botón 2",
      "default": "Our platform"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Link del botón 2"
    }
  ],
  "presets": [{ "name": "POS · Hero" }]
}
{% endschema %}
