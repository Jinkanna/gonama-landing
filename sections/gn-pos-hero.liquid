{% comment %}
  GOnama · new-pos · Hero
  Titular apilado en mayúsculas: cada línea entra desde abajo, escalonada.
  Las líneas se cargan una por renglón en el editor.

  Con el globo activado el hero fija su fondo noche: el globo de puntos y su
  resplandor solo funcionan sobre oscuro. El import map tiene que quedar antes
  de que se dispare cualquier script type=module de la página, y esta sección
  se renderiza antes que scripts-tag, así que este es su lugar.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
>
{%- render 'gn-pos-assets' -%}

{%- liquid
  assign st = section.settings
  assign lines = st.headline | newline_to_br | split: '<br />'
-%}

{%- if st.globe -%}
  <script type="importmap">
    {
      "imports": {
        "three": {{ 'gn-three.min.js' | asset_url | json }},
        "three/addons/controls/OrbitControls.js": {{ 'gn-three-orbit.js' | asset_url | json }},
        "three/addons/renderers/CSS2DRenderer.js": {{ 'gn-three-css2d.js' | asset_url | json }},
        "gn-globe-land": {{ 'gn-land-110m.js' | asset_url | json }}
      }
    }
  </script>
  <script src="{{ 'gn-pos-globe.js' | asset_url }}" type="module"></script>
{%- endif -%}

<section
  class="gnp gnp--{{ st.tone }} gnp-hero{% if st.globe %} gnp-hero--night gnp-hero--globe{% endif %}"
  id="section-hero"
>
  {%- if st.globe -%}
    <div class="gnp-hero__sky" aria-hidden="true"></div>
    <div
      class="gnp-hero__globe"
      data-gnp-globe
      aria-hidden="true"
    >
      <canvas class="gnp-hero__canvas"></canvas>
    </div>
  {%- endif -%}

  <div class="gnp__in">
    {%- if st.label != blank -%}
      <p class="gnp__label gnp-hero__label gnp-rv">{{ st.label | escape }}</p>
    {%- endif -%}

    <h1 class="gnp__display" data-gnp-lines>
      {%- for line in lines -%}
        {%- assign clean = line | strip_html | strip -%}
        {%- if clean != blank -%}
          <span class="gnp-line"><span>{{ clean | escape }}</span></span>
        {%- endif -%}
      {%- endfor -%}
    </h1>

    <div class="gnp-hero__foot">
      {%- if st.sub != blank -%}
        <p class="gnp__sub gnp-rv">{{ st.sub | escape }}</p>
      {%- endif -%}

      {%- if st.cta1_label != blank -%}
        <div class="gnp-hero__actions gnp-rv">
          <a class="gnp__btn" href="{{ st.cta1_link | default: '#gnp-contact' }}">
            {{ st.cta1_label | escape }}
            <svg class="gnp__arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "POS · Hero",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tono",
      "options": [
        {
          "value": "a",
          "label": "Base"
        },
        {
          "value": "b",
          "label": "Invertido"
        }
      ],
      "default": "a"
    },
    {
      "type": "checkbox",
      "id": "globe",
      "label": "Globo 3D",
      "info": "Con el globo activado el hero va siempre en fondo oscuro.",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Titular",
      "info": "Una línea por renglón. Cada renglón entra por separado.",
      "default": "Commerce that\nruns itself"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Bajada",
      "default": "One autonomous infrastructure where AI agents, checkout, payments and fulfillment execute commerce together."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Botón",
      "default": "Talk with us"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Link del botón"
    }
  ],
  "presets": [
    {
      "name": "POS · Hero"
    }
  ]
}
{% endschema %}
