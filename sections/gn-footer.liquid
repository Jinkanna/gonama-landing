{% comment %}
  GOnama landing 2026 — Footer propio de la home
  Reemplaza al footer del tema solo en index. Columnas de links como bloques.
{% endcomment %}

{%- comment -%}
  Marca que hay JS antes de que se parsee el resto: sin esto, si el script
  no carga, el reveal dejaria toda la landing invisible.
{%- endcomment -%}
<script>document.documentElement.classList.add('gn-js');</script>
{{ 'gn-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gn-landing.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
  assign year = 'now' | date: '%Y'

  # Si no se elige un logo en la sección, se usa el del tema (Settings › Logo).
  assign logo = st.logo | default: settings.logo_image_desktop
  # El logo del tema tiene "nama" en gris oscuro: sobre Panda 1 no se lee.
  assign logo_dark = st.logo_dark | default: st.logo | default: settings.logo_image_desktop
-%}

<footer class="gn gn-footer">
  <div class="gn__inner">
    <div class="gn-footer__top">
      <div class="gn-footer__brand">
        {%- if logo != blank -%}
        <img
          class="gn-footer__logo-img gn-logo-img gn-footer__logo-img gn-logo-img--light"
          src="{{ logo | image_url: height: 80 }}"
          alt="{{ shop.name | escape }}"
          loading="lazy"
        >
        <img
          class="gn-footer__logo-img gn-logo-img gn-footer__logo-img gn-logo-img--dark"
          src="{{ logo_dark | image_url: height: 80 }}"
          alt="{{ shop.name | escape }}"
          loading="lazy"
        >
      {%- else -%}
          <p class="gn-footer__wordmark">{{ st.logo_text }}</p>
        {%- endif -%}

        {%- if st.tagline != blank -%}
          <p class="gn-footer__tagline">{{ st.tagline | escape }}</p>
        {%- endif -%}
      </div>

      <div class="gn-footer__cols">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign rows = b.items | newline_to_br | split: '<br />'
          -%}
          <div class="gn-footer__col" {{ block.shopify_attributes }}>
            {%- if b.title != blank -%}
              <p class="gn-footer__col-title">{{ b.title | escape }}</p>
            {%- endif -%}
            <ul>
              {%- for row in rows -%}
                {%- liquid
                  assign parts = row | strip_html | strip | split: '|'
                  assign label = parts[0] | strip
                  assign href = parts[1] | strip
                -%}
                {%- if label != blank -%}
                  <li>
                    {%- if href != blank -%}
                      <a href="{{ href }}">{{ label | escape }}</a>
                    {%- else -%}
                      <span>{{ label | escape }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="gn-footer__bottom">
      <p>{{ st.copyright | replace: '{year}', year }}</p>
      {%- if st.legal != blank -%}
        <div class="gn-footer__legal">{{ st.legal }}</div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GN · Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Si lo dejás vacío se usa el texto de abajo."
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Logo para fondo oscuro",
      "info": "Se usa cuando el visitante tiene el navegador en modo oscuro. Si lo dejás vacío se usa el mismo de arriba."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo en texto",
      "default": "GOnama"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Bajada",
      "default": "Infrastructure for the autonomous economy."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "info": "Usá {year} para el año actual.",
      "default": "© {year} GOnama Holdings Ltd."
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Línea legal"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Ítems",
          "info": "Uno por línea, con el formato  Texto | destino  — el destino es opcional."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GN · Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Platform",
            "items": "AI Studio | #section-platform\nCommerce Infrastructure | #section-platform\nDeveloper Platform | #section-platform"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Company",
            "items": "Principles & Policies | #section-holdings\nContact | #gn-contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
