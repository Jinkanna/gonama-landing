{% comment %}
  GOnama landing 2026 — Footer propio de la home
  Reemplaza al footer del tema solo en index. Columnas de links como bloques.
{% endcomment %}

{%- comment -%}
  Marca que hay JS antes de que se parsee el resto: sin esto, si el script
  no carga, el reveal dejaria toda la landing invisible.
{%- endcomment -%}
<script>document.documentElement.classList.add('gn-js');</script>
{{ 'gn-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gn-landing.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
  assign year = 'now' | date: '%Y'

  # Si no se elige un logo en la sección, se usa el del tema (Settings › Logo).
  assign logo = st.logo | default: settings.logo_image_desktop
-%}

<footer class="gn gn-footer">
  <div class="gn__inner">
    <div class="gn-footer__top">
      <div class="gn-footer__brand">
        {%- render 'gn-logo',
          logo: logo,
          logo_dark: st.logo_dark,
          go: st.logo_go,
          rest: st.logo_rest,
          size: 32
        -%}

        {%- if st.tagline != blank -%}
          <p class="gn-footer__tagline">{{ st.tagline | escape }}</p>
        {%- endif -%}
      </div>

      <div class="gn-footer__cols">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign col_title = st.col1_title
                assign col_items = st.col1_items
              when 2
                assign col_title = st.col2_title
                assign col_items = st.col2_items
              else
                assign col_title = st.col3_title
                assign col_items = st.col3_items
            endcase
            assign rows = col_items | newline_to_br | split: '<br />'
          -%}
          {%- if col_title != blank or col_items != blank -%}
            <div class="gn-footer__col">
              {%- if col_title != blank -%}
                <p class="gn-footer__col-title">{{ col_title | escape }}</p>
              {%- endif -%}
              <ul>
                {%- for row in rows -%}
                  {%- liquid
                    assign parts = row | strip_html | strip | split: '|'
                    assign label = parts[0] | strip
                    assign href = parts[1] | strip
                  -%}
                  {%- if label != blank -%}
                    <li>
                      {%- if href != blank -%}
                        <a href="{{ href }}">{{ label | escape }}</a>
                      {%- else -%}
                        <span>{{ label | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="gn-footer__bottom">
      <p>{{ st.copyright | replace: '{year}', year }}</p>
      {%- if st.legal != blank -%}
        <div class="gn-footer__legal">{{ st.legal }}</div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GN · Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Si lo dejás vacío se usa el texto de abajo."
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Logo para fondo oscuro",
      "info": "Se usa cuando el visitante tiene el navegador en modo oscuro. Si lo dejás vacío se usa el mismo de arriba."
    },
    {
      "type": "text",
      "id": "logo_go",
      "label": "Logo en texto · parte en color",
      "info": "Solo se usa si no hay imagen de logo.",
      "default": "GO"
    },
    {
      "type": "text",
      "id": "logo_rest",
      "label": "Logo en texto · resto",
      "default": "nama"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Bajada",
      "default": "Infrastructure for the autonomous economy."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "info": "Usá {year} para el año actual.",
      "default": "© {year} GOnama Holdings Ltd."
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Línea legal"
    },
    {
      "type": "header",
      "content": "Columna 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Título",
      "default": "Platform"
    },
    {
      "type": "textarea",
      "id": "col1_items",
      "label": "Ítems",
      "info": "Uno por línea, con el formato  Texto | destino",
      "default": "AI Studio | #section-platform\nCommerce Infrastructure | #section-platform\nCommerce Intelligence | #section-platform\nGrowth & Retention | #section-platform\nDeveloper Platform | #section-platform"
    },
    {
      "type": "header",
      "content": "Columna 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Título",
      "default": "Solutions"
    },
    {
      "type": "textarea",
      "id": "col2_items",
      "label": "Ítems",
      "info": "Uno por línea, con el formato  Texto | destino",
      "default": "Global Checkout | #section-checkout\nImagine Code | #section-imagine\nIndustries | #section-industries"
    },
    {
      "type": "header",
      "content": "Columna 3"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Título",
      "default": "Company"
    },
    {
      "type": "textarea",
      "id": "col3_items",
      "label": "Ítems",
      "info": "Uno por línea, con el formato  Texto | destino",
      "default": "Principles & Policies | #section-holdings\nContact | #gn-contact"
    }
  ]
}
{% endschema %}
