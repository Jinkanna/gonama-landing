{% schema %}
{
  "name": "Custom Grid Builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Custom Grid"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Customize your grid like never before!</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "fluid", "label": "Fluid container" },
        { "value": "stretch", "label": "Stretch width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns per row (Desktop)",
      "min": 1,
      "max": 6,
      "default": 3,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows_desktop",
      "label": "Rows per section (Desktop)",
      "min": 1,
      "max": 6,
      "default": 3,
      "step": 1
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns per row (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "rows_mobile",
      "label": "Rows per section (Mobile)",
      "min": 1,
      "max": 6,
      "default": 2,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 0,
      "max": 50,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row Gap",
      "min": 0,
      "max": 50,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "default": 20,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "default": 20,
      "step": 5,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon (SVG or PNG)"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Content"
        }
      ]
    },
    {
      "type": "html",
      "name": "Custom HTML",
      "settings": [
        {
          "type": "html",
          "id": "custom_html",
          "label": "HTML Code",
          "default": "<p>Custom HTML Content</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Grid Builder",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="custom-grid layout-{{ section.settings.layout }} color-{{ section.settings.color_scheme }}"
     style="margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <h2>{{ section.settings.heading }}</h2>
  <div>{{ section.settings.description }}</div>

  <div class="custom-grid-container"
       data-columns-mobile="{{ section.settings.columns_mobile }}"
       data-rows-mobile="{{ section.settings.rows_mobile }}"
       data-columns-desktop="{{ section.settings.columns_desktop }}"
       data-rows-desktop="{{ section.settings.rows_desktop }}"
       style="display: grid;
              grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
              grid-template-rows: repeat({{ section.settings.rows_desktop }}, auto);
              column-gap: {{ section.settings.column_gap }}px;
              row-gap: {{ section.settings.row_gap }}px;
              text-align: {{ section.settings.text_alignment }};">
    {% for block in section.blocks %}
      <div class="custom-grid-item">
        {% case block.type %}
          {% when "image" %}
            <img src="{{ block.settings.image | img_url: 'large' }}" alt="Grid Image">
          {% when "icon" %}
            <img src="{{ block.settings.icon_image | img_url: 'small' }}" alt="Icon">
          {% when "text" %}
            <div>{{ block.settings.text }}</div>
          {% when "html" %}
            <div>{{ block.settings.custom_html }}</div>
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
function updateGridLayout() {
  let gridContainer = document.querySelector('.custom-grid-container');
  if (gridContainer) {
    let columnsMobile = parseInt(gridContainer.getAttribute('data-columns-mobile')) || 1;
    let rowsMobile = parseInt(gridContainer.getAttribute('data-rows-mobile')) || 1;
    let columnsDesktop = parseInt(gridContainer.getAttribute('data-columns-desktop')) || 3;
    let rowsDesktop = parseInt(gridContainer.getAttribute('data-rows-desktop')) || 1;

    gridContainer.style.removeProperty('grid-template-columns');
    gridContainer.style.removeProperty('grid-template-rows');

    if (window.innerWidth < 768) {
      gridContainer.style.gridTemplateColumns = `repeat(${columnsMobile}, 1fr)`;
      gridContainer.style.gridTemplateRows = `repeat(${rowsMobile}, auto)`;
    } else {
      gridContainer.style.gridTemplateColumns = `repeat(${columnsDesktop}, 1fr)`;
      gridContainer.style.gridTemplateRows = `repeat(${rowsDesktop}, auto)`;
    }
  }
}
document.addEventListener('DOMContentLoaded', () => { setTimeout(updateGridLayout, 200); });
window.addEventListener('resize', updateGridLayout);
</script>
