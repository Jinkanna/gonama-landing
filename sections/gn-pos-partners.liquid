{% comment %}
  GOnama · new-pos · Partners
  Cada celda acepta un logo o, si no hay imagen, el nombre en texto.
{% endcomment %}

{%- render 'gn-pos-assets' -%}

{%- liquid
  assign st = section.settings
-%}

<section class="gnp gnp--{{ st.tone }} gnp-part-sec" id="section-{{ section.id }}">
  <div class="gnp__in">
    <div class="gnp__head gnp__head--split">
      <div>
        {%- if st.label != blank -%}
          <p class="gnp__label gnp-rv" style="margin-bottom: 24px;">{{ st.label | escape }}</p>
        {%- endif -%}
        {%- if st.headline != blank -%}
          <h2 class="gnp__title gnp-rv">{{ st.headline | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if st.sub != blank -%}
        <p class="gnp__sub gnp-rv">{{ st.sub | escape }}</p>
      {%- endif -%}
    </div>

    <div class="gnp-part__strip">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="gnp-part gnp-rv" {{ block.shopify_attributes }}>
          {%- if b.kind != blank -%}
            <p class="gnp-part__kind">{{ b.kind | escape }}</p>
          {%- endif -%}

          {%- if b.logo != blank -%}
            <img
              class="gnp-part__logo"
              src="{{ b.logo | image_url: height: 120 }}"
              alt="{{ b.name | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <p class="gnp-part__name">{{ b.name | escape }}</p>
          {%- endif -%}

          {%- if b.note != blank -%}
            <p class="gnp-part__note">{{ b.note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if st.foot != blank -%}
      <p class="gnp-part__foot gnp-rv">{{ st.foot | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "POS · Partners",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tono",
      "options": [
        {
          "value": "a",
          "label": "Base"
        },
        {
          "value": "b",
          "label": "Invertido"
        }
      ],
      "default": "b"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "Ecosystem"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular",
      "default": "Connected to what you already use"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Bajada",
      "default": "The gateways, carriers and platforms you already use in Uruguay, integrated, so nothing has to be rebuilt."
    },
    {
      "type": "text",
      "id": "foot",
      "label": "Nota al pie",
      "default": "Using something that is not on the list? Tell us."
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "text",
          "id": "kind",
          "label": "Categoría",
          "info": "Qué resuelve. Va arriba del nombre."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Detalle",
          "info": "Una línea corta. Opcional."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Si lo cargás, reemplaza al nombre en texto."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "POS · Partners"
    }
  ]
}
{% endschema %}
