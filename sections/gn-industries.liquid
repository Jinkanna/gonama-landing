{% comment %}
  GOnama landing 2026 · Industries
  El HTML original usaba marquesinas animadas; acá es una grilla estática porque
  el contenido es una lista de referencia, no una demo de producto.
{% endcomment %}

{%- comment -%}
  Marca que hay JS antes de que se parsee el resto: sin esto, si el script
  no carga, el reveal dejaria toda la landing invisible.
{%- endcomment -%}
<script>document.documentElement.classList.add('gn-js');</script>
{{ 'gn-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gn-landing.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
-%}

<section class="gn gn-industries" id="section-{{ section.id }}">
  <div class="gn__inner">
    <div class="gn__head gn__head--center gn-reveal">
      {%- if st.eyebrow != blank -%}
        <p class="gn__eyebrow">{{ st.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if st.heading != blank -%}
        <h2 class="gn__h2">{{ st.heading | escape }}</h2>
      {%- endif -%}
      {%- if st.lead != blank -%}
        <p class="gn__lead">{{ st.lead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="gn-industries__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign subs = b.subs | split: ','
        -%}
        <article class="gn-ind gn-reveal" {{ block.shopify_attributes }}>
          <h3 class="gn-ind__title">{{ b.title | escape }}</h3>
          {%- if b.subs != blank -%}
            <p class="gn-ind__subs">
              {%- for sub in subs -%}
                {%- assign clean = sub | strip -%}
                {%- if clean != blank -%}
                  {{- clean | escape -}}
                  {%- unless forloop.last %} · {% endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
